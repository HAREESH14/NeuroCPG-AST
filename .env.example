# =============================================================================
#  NeuroAST — Environment Configuration
#
#  Copy this file to .env and fill in your API keys:
#    cp .env.example .env
#
#  NEVER commit .env to version control!
# =============================================================================

# ── NeuroAST Pipeline Settings ──────────────────────────────────────────────
# NEUROAST_MODEL=groq/llama-3.3-70b-versatile
# NEUROAST_MAX_RETRIES=3
# NEUROAST_VERIFIER_TYPE=tree-sitter          # or "cpg" for Phase 2
# NEUROAST_CONFIDENCE_THRESHOLD=0.95

# ── LLM Provider (pick ONE, uncomment its block) ───────────────────────────

# Option 1: Groq (Cloud, FREE tier available)
LLM_REPAIR_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_key_here

# Option 2: Ollama (Local, FREE, no internet)
# LLM_REPAIR_MODEL=ollama/qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434

# Option 3: OpenAI (Cloud, paid)
# LLM_REPAIR_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Option 4: Anthropic (Cloud, paid)
# LLM_REPAIR_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Option 5: Google Gemini
# LLM_REPAIR_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=AIza...

# ── Joern CPG Server (Phase 2 only) ────────────────────────────────────────
# JOERN_HOST=localhost
# JOERN_PORT=8080

# ── Debug ───────────────────────────────────────────────────────────────────
# LITELLM_DEBUG=true
